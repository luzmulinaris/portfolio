---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../i18n/utils';
import { withBase, categoryKey } from '../lib/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  index?: number;
  /** Larger, feature-row presentation. */
  feature?: boolean;
}

const { project, lang, index, feature = false } = Astro.props;
const t = useTranslations(lang);
const d = project.data;
const href = localePath(lang, `work/${project.id}`);
const num = index !== undefined ? String(index + 1).padStart(2, '0') : undefined;
const alt = d.coverAlt?.[lang] ?? d.title[lang];
---

<a
  href={href}
  class="group relative block"
  data-reveal
  data-category={d.category}
  style={`--accent: ${d.accent ?? 'var(--color-pink)'}`}
>
  <figure
    class={`relative overflow-hidden rounded-xl bg-cream-200 ${feature ? 'aspect-[16/11]' : 'aspect-[4/3]'}`}
  >
    <img
      src={withBase(d.cover)}
      alt={alt}
      width="1600"
      height="1067"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-[800ms] ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-[1.04]"
    />
    <span
      class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-x-100"
      style="background: var(--accent)"
      aria-hidden="true"></span>
    {
      num && (
        <span class="mono absolute left-4 top-4 rounded-full bg-cream/85 px-2.5 py-1 text-[0.7rem] font-medium text-ink backdrop-blur">
          {num}
        </span>
      )
    }
  </figure>

  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow text-ink-500">
        {t(categoryKey[d.category])} · {d.year}
      </p>
      <h3
        class={`mt-2 font-display uppercase leading-[0.95] tracking-tight text-ink transition-colors group-hover:text-[color:var(--accent)] ${feature ? 'text-4xl sm:text-5xl' : 'text-2xl sm:text-3xl'}`}
      >
        {d.title[lang]}
      </h3>
      <p class="mt-2 max-w-md text-sm text-ink-500">{d.summary[lang]}</p>
    </div>
    <span
      class="mt-1 shrink-0 text-xl text-ink transition-transform duration-300 group-hover:translate-x-1 group-hover:text-[color:var(--accent)]"
      aria-hidden="true">↗</span>
  </div>
</a>
