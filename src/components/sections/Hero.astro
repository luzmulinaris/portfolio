---
import { useTranslations, type Lang } from '../../i18n/utils';
import LeadReveal, { type LeadPart } from '../react/LeadReveal.tsx';
import Marquee from '../Marquee.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const leadParts: Record<Lang, LeadPart[]> = {
  en: [
    { text: 'I design' },
    { text: 'editorial pieces,', mark: true },
    { text: 'digital pieces,', mark: true },
    { text: 'visual identity', mark: true },
    { text: 'and' },
    { text: 'information design', mark: true },
  ],
  es: [
    { text: 'Diseño' },
    { text: 'piezas editoriales,', mark: true },
    { text: 'piezas digitales,', mark: true },
    { text: 'identidad visual', mark: true },
    { text: 'y' },
    { text: 'diseño de información', mark: true },
  ],
};

const marqueeItems =
  lang === 'es'
    ? ['Editorial', 'Packaging', 'Identidad Visual', 'Redes', 'Tipografía']
    : ['Editorial', 'Packaging', 'Visual Identity', 'Social', 'Typography'];
---

<section class="relative flex min-h-[100svh] flex-col justify-between pt-[var(--nav-h)]">
  <div class="container-edge flex flex-1 flex-col justify-center py-10">
    <div class="flex items-center justify-between">
      <p class="eyebrow flex items-center gap-2 text-ink">
        <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-pink"></span>
        {t('hero.available')}
      </p>
      <p class="eyebrow hidden text-ink-500 sm:block">{t('hero.location')}</p>
    </div>

    <h1
      class="mt-8 font-display uppercase leading-[0.85] tracking-[-0.02em] text-ink"
      style="font-size: var(--text-mega)"
      data-reveal
    >
      <span class="block">{lang === 'es' ? 'Diseñadora' : 'Graphic'}</span>
      <span class="block">{lang === 'es' ? 'Gráfica' : 'Designer'}<span class="text-pink">.</span></span>
    </h1>

    <LeadReveal
      client:visible
      parts={leadParts[lang]}
      className="mt-10 max-w-3xl text-balance text-2xl leading-snug text-ink-700 sm:text-3xl"
    />
  </div>

  <div class="border-y border-line py-4">
    <Marquee items={marqueeItems} />
  </div>
</section>
