---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Experience from '../../components/sections/Experience.astro';
import Background from '../../components/sections/Background.astro';
import Capabilities from '../../components/sections/Capabilities.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { withBase } from '../../lib/utils';
import { about, contact } from '../../data/cv';

export const getStaticPaths = (() => [
  { params: { lang: 'en' } },
  { params: { lang: 'es' } },
]) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const facts = [
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
  { label: lang === 'es' ? 'Teléfono' : 'Phone', value: contact.phone, href: contact.phoneHref },
  { label: lang === 'es' ? 'Ubicación' : 'Location', value: contact.location[lang] },
  { label: 'LinkedIn', value: contact.linkedin, href: contact.linkedinUrl },
];
---

<BaseLayout lang={lang} title={t('about.title')} description={about.bio[0]!.en}>
  <!-- Intro -->
  <section class="container-edge pt-[calc(var(--nav-h)+3rem)]">
    <p class="eyebrow text-pink-ink">01_ {t('about.title')}</p>
    <h1
      class="mt-4 font-display uppercase leading-[0.85] tracking-tight text-ink"
      style="font-size: var(--text-mega)"
    >
      {about.hello[lang]}
    </h1>

    <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5 lg:col-span-4" data-reveal>
        <div class="overflow-hidden rounded-xl bg-cream-200">
          <img
            src={withBase('/images/luz-portrait.webp')}
            alt={lang === 'es' ? 'Retrato de Luz Mulinaris' : 'Portrait of Luz Mulinaris'}
            width="1100"
            height="1156"
            decoding="async"
            class="aspect-[4/5] w-full object-cover object-top"
          />
        </div>
      </div>

      <div class="md:col-span-7 lg:col-span-8" data-reveal style="--reveal-delay:120ms">
        <div class="space-y-5 text-lg leading-relaxed text-ink-700 md:text-2xl">
          {about.bio.map((p) => <p>{p[lang]}</p>)}
        </div>

        <dl class="mt-10 grid grid-cols-1 gap-6 border-t border-line pt-8 sm:grid-cols-2">
          {
            facts.map((f) => (
              <div>
                <dt class="eyebrow text-ink-500">{f.label}</dt>
                <dd class="mt-1">
                  {f.href ? (
                    <a href={f.href} rel="noopener" class="link-underline text-ink hover:text-pink">
                      {f.value}
                    </a>
                  ) : (
                    <span class="text-ink">{f.value}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <Experience lang={lang} number="02" />
  <Background lang={lang} number="03" />
  <Capabilities lang={lang} number="04" />
</BaseLayout>
